{
  "name": "pi-mini-boss",
  "version": "0.9.10",
  "description": "🧠 Persistent memory + 🔍 session search + 🛡️ secret scanning for Pi. Bootstrap module for Pi: config, onboarding, extension check, workflow, dashboard. Forked from pi-hermes-memory (memory + session search + skills).",
  "type": "module",
  "main": "src/index.ts",
  "files": [
    "src",
    "scripts",
    "bin",
    "config",
    "skills",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "bin": {
    "pi-mini-boss-board": "./bin/pi-mini-boss-board.mjs"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "check": "node scripts/ensure-dev.mjs check && tsc --noEmit",
    "check:min-sdk": "node scripts/ensure-dev.mjs check && node scripts/check-min-sdk.mjs",
    "check:production": "node scripts/check-production-install.mjs",
    "test": "node scripts/ensure-dev.mjs test && tests/run-all.sh"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "memory",
    "persistent-memory",
    "session-search",
    "sqlite",
    "fts5",
    "skills",
    "learning-loop",
    "agent",
    "hermes",
    "secret-scanning",
    "content-scanner",
    "correction-detection",
    "auto-consolidation",
    "memory-aging",
    "context-fencing",
    "two-tier-memory"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vaytekhovski/pi-mini-boss"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.80.6",
    "@earendil-works/pi-coding-agent": ">=0.80.6",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.80.2",
    "@earendil-works/pi-coding-agent": "^0.80.2",
    "@earendil-works/pi-tui": "^0.80.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "tsx": "^4.21.0",
    "typebox": "^1.1.33",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.13",
    "js-yaml": "^4.1.0",
    "strip-ansi": "7.2.0"
  }
}
